generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String          @id
  title     String          @default("New chat")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  StoredMessage[]
}

model StoredMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String
  sequence       Int
  role           String
  payload        String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, kind, sequence])
  @@index([conversationId, kind, sequence])
}

model Provider {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  apiBase   String
  apiKey    String?
  isActive  Boolean  @default(true)
  models    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
