generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String          @id
  title     String          @default("New chat")
  projectId String?
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  StoredMessage[]
  runs      ThreadRun[]
  tasks     AgentTask[]
}

model StoredMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String
  sequence       Int
  role           String
  payload        String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, kind, sequence])
  @@index([conversationId, kind, sequence])
}

model Provider {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  apiBase   String
  apiKey    String?
  isActive  Boolean  @default(true)
  models    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                String         @id @default(uuid())
  name              String         @unique
  rootPath          String
  description       String?
  defaultAgentId    String?
  defaultProviderId String?
  defaultModelId    String?
  toolPermissions   String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  conversations     Conversation[]
  runs              ThreadRun[]
}

model AgentConfig {
  id                String   @id
  name              String   @unique
  description       String
  instructions      String
  toolPermissions   String
  readOnly          Boolean  @default(false)
  subAgents         String
  defaultProviderId String?
  defaultModelId    String?
  isActive          Boolean  @default(true)
  isBuiltIn         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ThreadRun {
  id             String         @id @default(uuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentId        String?
  thinkingMode   String         @default("fast")
  permissionMode String         @default("confirm")
  providerId     String?
  modelId        String?
  status         String         @default("queued")
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  events         RunEvent[]
  approvals      ToolApproval[]
  tasks          AgentTask[]

  @@index([conversationId, status, createdAt])
  @@index([projectId, createdAt])
}

model RunEvent {
  id        String    @id @default(uuid())
  runId     String
  run       ThreadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence  Int
  eventType String
  payload   String
  createdAt DateTime  @default(now())

  @@unique([runId, sequence])
  @@index([runId, sequence])
}

model ToolApproval {
  id         String    @id @default(uuid())
  runId      String
  run        ThreadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolName   String
  input      String
  reason     String?
  status     String    @default("pending")
  decisionBy String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([runId, status])
}

model AgentTask {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId          String?
  run            ThreadRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  taskId         Int
  subject        String
  description    String?
  status         String       @default("pending")
  activeForm     String?
  owner          String?
  metadata       String?
  blockedBy      String?
  blocks         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, taskId])
  @@index([conversationId, status, taskId])
  @@index([runId])
}

/// Registry-backed catalog row for every tool a provider can contribute.
/// id is the tool name (e.g. "readFile", future "mcp:{server}_{tool}").
/// Metadata is refreshed from ToolProviderRegistry on startup; isActive and
/// config are user-owned and never overwritten by the sync.
model ToolRecord {
  id          String   @id
  label       String
  description String
  risk        String   @default("medium")
  mutating    Boolean  @default(false)
  providerId  String   @default("builtin")
  isActive    Boolean  @default(true)
  config      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId])
}
